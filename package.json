{
  "name": "blog",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "npm run check:schemas && astro build && pagefind --site dist",
    "preview": "node scripts/serve.mjs",
    "check": "astro check",
    "check:schemas": "node scripts/check-schemas.ts",
    "check:contrast": "node scripts/check-contrast.ts",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "playwright test --trace off",
    "test:cms": "playwright test -c playwright.cms.config.ts --trace off",
    "lhci": "lhci autorun"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.3.9",
    "@astrojs/mdx": "8.1.6",
    "@astrojs/netlify": "8.2.14",
    "@astrojs/react": "7.1.9",
    "@astrojs/rss": "4.0.19",
    "@astrojs/sitemap": "3.7.5",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/source-serif-4": "5.3.1",
    "@keystatic/astro": "6.0.0",
    "@keystatic/core": "0.6.9",
    "astro": "7.4.12",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "reading-time": "1.5.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@lhci/cli": "0.16.1",
    "@playwright/test": "1.65.1",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.15.0",
    "eslint-plugin-astro": "3.2.1",
    "pagefind": "1.6.0",
    "prettier": "3.10.1",
    "prettier-plugin-astro": "1.1.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0"
  },
  "engines": {
    "node": ">=22.19"
  }
}
