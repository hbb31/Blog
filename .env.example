# Copy to .env for local overrides. Never commit .env.
# In production, set these in Netlify: Site configuration → Environment variables.

# --- Keystatic storage ------------------------------------------------------
# "local" (default) edits files on disk. "github" commits to branches on GitHub.
PUBLIC_KEYSTATIC_STORAGE=local
# GitHub repo the CMS commits to (owner/name).
PUBLIC_KEYSTATIC_GITHUB_REPO=hbb31/Blog
# Your Netlify site name (the "<name>" in <name>.netlify.app). Enables
# "Preview" links in the CMS that open the branch deploy for the current branch.
PUBLIC_NETLIFY_SITE_NAME=

# --- Keystatic GitHub mode secrets (production only) ------------------------
# Created by Keystatic's GitHub App setup flow (see docs/PUBLISHING.md).
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
KEYSTATIC_SECRET=
PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=

# --- Build ------------------------------------------------------------------
# Overrides siteUrl from Site settings (useful for staging).
SITE_URL=
# Show draft posts (set automatically for Netlify previews in netlify.toml).
# Ignored on production deploys.
SHOW_DRAFTS=false
