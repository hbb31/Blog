---
import SearchBox from './SearchBox.astro';
import NewsletterForm from './NewsletterForm.astro';
import AuthorBio from './AuthorBio.astro';
import PostCard from './PostCard.astro';
import { getCategoriesWithCounts, getPosts, categoryUrl } from '../lib/content';

interface Props {
  excludePostId?: string;
}
const { excludePostId } = Astro.props;
const [cats, posts] = await Promise.all([getCategoriesWithCounts(), getPosts()]);
const recent = posts.filter((p) => p.id !== excludePostId).slice(0, 4);
---

<aside class="sidebar" aria-label="Sidebar">
  <section class="sidebar__block" aria-labelledby="sidebar-search-heading">
    <h2 class="sidebar__heading" id="sidebar-search-heading">
      Search
    </h2>
    <SearchBox id="sidebar-search" />
  </section>

  <NewsletterForm id="sidebar-newsletter" variant="sidebar" />

  <section class="sidebar__block" aria-labelledby="sidebar-cats-heading">
    <h2 class="sidebar__heading" id="sidebar-cats-heading">
      Categories
    </h2>
    <ul class="sidebar__cats">
      {cats.map(({ category, count }) => (
        <li>
          <a href={categoryUrl(category.id)}>{category.data.name}</a>
          <span class="meta" aria-label={`${count} posts`}>
            {count}
          </span>
        </li>
      ))}
    </ul>
  </section>

  <section class="sidebar__block">
    <AuthorBio variant="card" />
  </section>

  <section class="sidebar__block" aria-labelledby="sidebar-recent-heading">
    <h2 class="sidebar__heading" id="sidebar-recent-heading">
      Recent posts
    </h2>
    <div class="sidebar__recent">
      {recent.map((post) => (
        <PostCard post={post} variant="compact" headingLevel={3} />
      ))}
    </div>
  </section>
</aside>

<style>
  .sidebar {
    display: grid;
    gap: var(--space-6);
    align-content: start;
    font-size: var(--text-sm);
  }

  .sidebar__heading {
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-muted);
    font-weight: 600;
    margin-bottom: var(--space-3);
  }

  .sidebar__cats {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .sidebar__cats li {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: var(--hairline);
  }

  .sidebar__cats a {
    display: block;
    padding-block: var(--space-2);
    min-height: 40px;
    line-height: 24px;
  }

  .sidebar__recent {
    display: grid;
    gap: var(--space-4);
  }
</style>
