---
import { getNavPages, getSettings } from '../lib/content';
import Icon from './Icon.astro';
const [settings, pages] = await Promise.all([getSettings(), getNavPages()]);
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container site-footer__inner">
    <div class="site-footer__about">
      <p class="site-footer__title">{settings.title}</p>
      {settings.footerText && <p class="meta">{settings.footerText}</p>}
    </div>
    <nav aria-label="Footer">
      <ul class="site-footer__links">
        <li>
          <a href="/blog/">Blog</a>
        </li>
        {pages.map((p) => (
          <li>
            <a href={`/${p.id}/`}>{p.data.title}</a>
          </li>
        ))}
        <li>
          <a href="/search/">Search</a>
        </li>
        <li>
          <a href="/rss.xml" class="rss-link">
            <Icon name="rss" size={16} /> RSS
          </a>
        </li>
      </ul>
    </nav>
    {settings.socialLinks.length > 0 && (
      <ul class="site-footer__links" aria-label="Social profiles">
        {settings.socialLinks.map((s) => (
          <li>
            <a href={s.url} rel="me noopener">
              {s.label}
            </a>
          </li>
        ))}
      </ul>
    )}
    <p class="meta site-footer__copy">
      © {year} {settings.title}. All rights reserved.
    </p>
  </div>
</footer>

<style>
  .site-footer {
    border-top: var(--hairline);
    background: var(--color-surface);
    margin-top: var(--space-8);
  }

  .site-footer__inner {
    display: grid;
    gap: var(--space-4);
    padding-block: var(--space-6);
    font-size: var(--text-sm);
  }

  .site-footer__title {
    font-family: var(--font-display);
    letter-spacing: -0.02em;
    font-weight: var(--weight-display);
    font-size: var(--text-lg);
    margin: 0 0 var(--space-2);
  }

  .site-footer__about p.meta {
    margin: 0;
    max-width: 50ch;
  }

  .site-footer__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-5);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .site-footer__links a {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    min-height: 32px;
  }

  .site-footer__copy {
    margin: 0;
  }
</style>
