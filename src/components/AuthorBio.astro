---
import { Image } from 'astro:assets';
import { getAuthor } from '../lib/content';
interface Props {
  variant?: 'box' | 'card' | 'about';
}
const { variant = 'box' } = Astro.props;
const author = await getAuthor();
const size = variant === 'about' ? 160 : variant === 'box' ? 96 : 56;
const Heading = variant === 'about' ? 'h2' : variant === 'box' ? 'h2' : 'h3';
---

<section class:list={['author', `author--${variant}`]} aria-label="About the author">
  {author.photo && (
    <Image
      class="author__photo"
      src={author.photo}
      alt={author.photoAlt ?? author.name}
      width={size}
      height={size}
      densities={[1, 2]}
      loading="lazy"
    />
  )}
  <div>
    {variant === 'box' && <p class="author__eyebrow">Written by</p>}
    <Heading class="author__name">{author.name}</Heading>
    <p class="author__bio">{author.shortBio}</p>
    {variant !== 'card' && author.socialLinks.length > 0 && (
      <ul class="author__links" aria-label={`${author.name} elsewhere`}>
        {author.socialLinks.map((s) => (
          <li>
            <a href={s.url} rel="me noopener" target="_blank">
              {s.label}
            </a>
          </li>
        ))}
      </ul>
    )}
    {variant === 'card' && (
      <a class="author__more" href="/about/">
        More about me →
      </a>
    )}
  </div>
</section>

<style>
  .author {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: var(--space-4);
    align-items: start;
  }

  .author--box {
    padding: var(--space-5);
    border: var(--hairline);
    border-radius: var(--radius-md);
  }

  .author__photo {
    border-radius: 50%;
    object-fit: cover;
  }

  .author__eyebrow {
    margin: 0;
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-muted);
  }

  .author__name {
    font-family: var(--font-serif);
    font-size: var(--text-lg);
    font-weight: 600;
  }

  .author--about .author__name {
    font-size: var(--text-2xl);
  }

  .author__bio {
    margin: var(--space-2) 0;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .author--about .author__bio {
    font-size: var(--text-base);
  }

  .author__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-4);
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: var(--text-sm);
  }

  .author__more {
    font-size: var(--text-sm);
  }
</style>
