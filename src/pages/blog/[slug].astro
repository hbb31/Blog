---
import type { GetStaticPaths } from 'astro';
import { Image, Picture } from 'astro:assets';
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Sidebar from '../../components/Sidebar.astro';
import ShareButtons from '../../components/ShareButtons.astro';
import NewsletterForm from '../../components/NewsletterForm.astro';
import AuthorBio from '../../components/AuthorBio.astro';
import PostCard from '../../components/PostCard.astro';
import TableOfContents from '../../components/TableOfContents.astro';
import { mdxComponents } from '../../components/mdx';
import {
  getAuthor,
  getCategoryMap,
  getPosts,
  getSettings,
  formatDate,
  postUrl,
  readingMinutes,
  relatedPosts,
  categoryUrl,
  tagUrl,
} from '../../lib/content';

export const getStaticPaths = (async () => {
  const posts = await getPosts();
  return posts.map((post, i) => ({
    params: { slug: post.id },
    // `posts` is newest first: "previous" is the older post, "next" the newer.
    props: { post, older: posts[i + 1], newer: posts[i - 1] },
  }));
}) satisfies GetStaticPaths;

const { post, older, newer } = Astro.props;
const { data } = post;
const { Content, headings } = await render(post);
const [author, settings, categoryMap, allPosts] = await Promise.all([
  getAuthor(),
  getSettings(),
  getCategoryMap(),
  getPosts(),
]);

const categories = data.categories.map((c) => categoryMap.get(c.id)).filter((c) => c !== undefined);
const minutes = readingMinutes(post);
const url = new URL(postUrl(post), Astro.site).href;
const showToc = headings.filter((h) => h.depth === 2 && h.slug !== 'footnote-label').length > 4;

let related = relatedPosts(post, allPosts, 3);
if (related.length < 3) {
  related = [...related, ...allPosts.filter((p) => p.id !== post.id && !related.includes(p))].slice(0, 3);
}

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: data.title,
  description: data.excerpt,
  datePublished: data.publishedAt.toISOString(),
  dateModified: (data.updatedAt ?? data.publishedAt).toISOString(),
  author: { '@type': 'Person', name: author.name, url: new URL('/about/', Astro.site).href },
  publisher: { '@type': 'Organization', name: settings.title, url: new URL('/', Astro.site).href },
  mainEntityOfPage: { '@type': 'WebPage', '@id': url },
  articleSection: categories.map((c) => c.data.name),
  keywords: data.tags.join(', '),
  wordCount: (post.body ?? '').split(/\s+/).length,
};
---

<BaseLayout
  title={data.seoTitle ?? data.title}
  description={data.excerpt}
  image={data.ogImage ?? data.coverImage}
  imageAlt={data.coverAlt}
  canonical={data.canonicalUrl}
  type="article"
  publishedTime={data.publishedAt}
  modifiedTime={data.updatedAt}
  jsonLd={jsonLd}
>
  <div class="container with-sidebar">
    <article class="post" data-pagefind-body={data.status === 'published' ? '' : undefined}>
      <header class="post__header">
        <ul class="post__cats" aria-label="Categories">
          {categories.map((c) => (
            <li>
              <a class="chip" href={categoryUrl(c.id)} data-pagefind-filter="category">
                {c.data.name}
              </a>
            </li>
          ))}
        </ul>
        <h1 class="post__title" data-pagefind-meta="title">
          {data.title}
          {data.status === 'draft' && <span class="draft-badge">Draft</span>}
        </h1>
        <p class="post__standfirst">{data.excerpt}</p>
        <div class="post__byline">
          {author.photo && (
            <Image src={author.photo} alt="" width={44} height={44} densities={[1, 2]} class="post__avatar" />
          )}
          <div class="meta">
            <p class="post__author">
              By <a href="/about/">{author.name}</a>
            </p>
            <p>
              <time datetime={data.publishedAt.toISOString()}>{formatDate(data.publishedAt)}</time>
              {data.updatedAt && (
                <>
                  <span aria-hidden="true"> · </span>Updated{' '}
                  <time datetime={data.updatedAt.toISOString()}>{formatDate(data.updatedAt)}</time>
                </>
              )}
              <span aria-hidden="true"> · </span>
              <span>{minutes} min read</span>
            </p>
          </div>
        </div>
      </header>

      {data.coverImage && (
        <figure class="post__cover">
          <Picture
            src={data.coverImage}
            alt={data.coverAlt ?? ''}
            formats={['avif', 'webp']}
            quality={70}
            widths={[360, 480, 640, 800, 1200, 1600]}
            sizes="(min-width: 76rem) 880px, (min-width: 60rem) calc(100vw - 380px), 100vw"
            loading="eager"
            fetchpriority="high"
            data-pagefind-meta="image[src], image_alt[alt]"
          />
          {data.coverCaption && <figcaption class="meta">{data.coverCaption}</figcaption>}
        </figure>
      )}

      {showToc && <TableOfContents headings={headings} />}

      <div class="prose post__body">
        <Content components={mdxComponents} />
      </div>

      {data.tags.length > 0 && (
        <ul class="post__tags" aria-label="Tags" data-pagefind-ignore>
          {data.tags.map((t) => (
            <li>
              <a class="chip chip--tag" href={tagUrl(t)}>
                #{t}
              </a>
            </li>
          ))}
        </ul>
      )}

      <div data-pagefind-ignore>
        <ShareButtons url={url} title={data.title} text={data.excerpt} />
        <NewsletterForm id="post-newsletter" variant="large" />
        <div class="post__author-box">
          <AuthorBio variant="box" />
        </div>

        <nav class="post-nav" aria-label="Previous and next post">
          {older ? (
            <a href={postUrl(older)} rel="prev" class="post-nav__link">
              <span class="meta">← Previous post</span>
              <span class="post-nav__title">{older.data.title}</span>
            </a>
          ) : (
            <span />
          )}
          {newer && (
            <a href={postUrl(newer)} rel="next" class="post-nav__link post-nav__link--next">
              <span class="meta">Next post →</span>
              <span class="post-nav__title">{newer.data.title}</span>
            </a>
          )}
        </nav>

        {related.length > 0 && (
          <section class="related" aria-labelledby="related-heading">
            <h2 id="related-heading" class="related__heading">
              Related posts
            </h2>
            <div class="related__grid">
              {related.map((p) => (
                <PostCard post={p} headingLevel={3} />
              ))}
            </div>
          </section>
        )}
      </div>
    </article>
    <Sidebar excludePostId={post.id} />
  </div>
</BaseLayout>

<style>
  .post {
    min-width: 0;
  }

  .post__header {
    max-width: var(--measure);
  }

  .post__cats,
  .post__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    list-style: none;
    margin: 0 0 var(--space-4);
    padding: 0;
  }

  .post__tags {
    margin-top: var(--space-6);
  }

  .post__title {
    font-family: var(--font-display);
    font-size: var(--text-4xl);
    font-weight: var(--weight-display);
    letter-spacing: -0.01em;
  }

  .post__standfirst {
    font-family: var(--font-serif);
    font-size: var(--text-xl);
    line-height: 1.45;
    color: var(--color-text-muted);
    margin: var(--space-4) 0 var(--space-5);
  }

  .post__byline {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding-block: var(--space-4);
    border-block: var(--hairline);
  }

  .post__byline p {
    margin: 0;
  }

  .post__author {
    color: var(--color-text);
    font-weight: 600;
  }

  .post__avatar {
    border-radius: 50%;
  }

  .post__cover {
    margin: var(--space-6) 0;
  }

  .post__cover img {
    width: 100%;
    border-radius: var(--radius-md);
  }

  .post__cover figcaption {
    margin-top: var(--space-2);
  }

  .post__body {
    margin-top: var(--space-6);
  }

  .post__author-box {
    margin-block: var(--space-6);
  }

  .post-nav {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-4);
    margin-block: var(--space-6);
    padding-top: var(--space-5);
    border-top: var(--hairline);
  }

  .post-nav__link {
    display: grid;
    gap: var(--space-1);
    text-decoration: none;
  }

  .post-nav__link--next {
    text-align: right;
  }

  .post-nav__title {
    font-family: var(--font-display);
    letter-spacing: -0.02em;
    font-weight: var(--weight-display);
    font-size: var(--text-lg);
    color: var(--color-text);
  }

  .post-nav__link:hover .post-nav__title {
    color: var(--color-accent);
    text-decoration: underline;
  }

  .related__heading {
    font-family: var(--font-display);
    letter-spacing: -0.02em;
    font-weight: var(--weight-display);
    font-size: var(--text-2xl);
    margin-bottom: var(--space-2);
  }

  .draft-badge {
    display: inline-block;
    vertical-align: middle;
    margin-left: var(--space-2);
    padding: 0.1em 0.5em;
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    border: 1px solid var(--color-error);
    color: var(--color-error);
    border-radius: var(--radius-pill);
  }
</style>
