---
/**
 * Full search powered by Pagefind. The index is built after `astro build`
 * (see the `postbuild` script) from the prerendered HTML, so this works only
 * on built output (`npm run build && npm run preview`), not in `astro dev`.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Search" description="Search all posts.">
  <link rel="stylesheet" href="/pagefind/pagefind-ui.css" slot="head" />
  <div class="container search-page">
    <h1 class="page-title">Search</h1>
    <noscript>
      <p class="page-intro">
        Search needs JavaScript. You can browse posts by category on the <a href="/blog/">blog page</a> instead.
      </p>
    </noscript>
    <div id="search" data-search></div>
    <p class="meta search-page__fallback" data-search-fallback hidden>
      The search index isn't available. It is generated by <code>npm run build</code>; run <code>npm run preview</code>{' '}
      to try search locally.
    </p>
  </div>
</BaseLayout>

<script is:inline src="/pagefind/pagefind-ui.js"></script>
<script>
  declare global {
    interface Window {
      PagefindUI?: new (opts: Record<string, unknown>) => { triggerSearch(q: string): void };
    }
  }

  const el = document.querySelector('[data-search]');
  if (el && window.PagefindUI) {
    const ui = new window.PagefindUI({
      element: '[data-search]',
      showSubResults: true,
      showImages: false,
      resetStyles: false,
      autofocus: true,
      translations: { placeholder: 'Search posts' },
    });
    const q = new URLSearchParams(location.search).get('q');
    if (q) ui.triggerSearch(q);
  } else {
    document.querySelector<HTMLElement>('[data-search-fallback]')?.removeAttribute('hidden');
  }
</script>

<style is:global>
  .search-page {
    max-width: 52rem;
    padding-block: var(--space-6) var(--space-8);
  }

  .search-page {
    --pagefind-ui-scale: 0.9;
    --pagefind-ui-primary: var(--color-accent);
    --pagefind-ui-text: var(--color-text);
    --pagefind-ui-background: var(--color-bg);
    --pagefind-ui-border: var(--color-border-strong);
    --pagefind-ui-tag: var(--color-surface);
    --pagefind-ui-border-width: 1px;
    --pagefind-ui-border-radius: 6px;
    --pagefind-ui-font: var(--font-sans);
  }

  .search-page .pagefind-ui__result-title {
    font-family: var(--font-serif);
  }

  .search-page .pagefind-ui__result-excerpt mark {
    background: var(--color-callout-warning);
    color: inherit;
  }
</style>
